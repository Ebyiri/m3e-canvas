{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M3E Canvas",
  "version": "0.1.0",
  "identifier": "com.ebyiri.m3e-canvas",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "M3E Canvas",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
